[sub_resource type="Shader" id="GroundShader"]
code = "shader_type spatial;
render_mode cull_back, diffuse_burley;

uniform sampler2D disp_tex : hint_default_black, repeat_disable, filter_linear;
uniform vec2 field_center = vec2(0.0);
uniform float field_size = 46.0;
uniform float dent_depth = 0.3;
uniform vec3 powder_color : source_color = vec3(0.86, 0.9, 0.98);
uniform vec3 packed_color : source_color = vec3(0.34, 0.42, 0.56);
uniform vec3 hollow_tint : source_color = vec3(0.46, 0.58, 0.8);

varying float v_track;
varying float v_low;
varying vec3 v_world;

float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }

void vertex() {
	vec3 wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	v_world = wp;
	vec2 uv = (wp.xz - field_center) / field_size + 0.5;
	float t = texture(disp_tex, uv).r;
	v_track = t;
	v_low = clamp(0.35 - wp.y * 0.7, 0.0, 1.0);
	VERTEX.y -= t * dent_depth;
}

void fragment() {
	float sp = step(0.9975, hash(floor(v_world.xz * 340.0))) * (1.0 - v_track);
	vec3 base = mix(powder_color, packed_color, smoothstep(0.04, 0.65, v_track));
	base = mix(base, hollow_tint, v_low * 0.4);
	float d = length(v_world.xz - field_center) / (field_size * 0.5);
	base = mix(base, vec3(0.42, 0.5, 0.62), clamp(d - 0.55, 0.0, 1.0) * 0.7);
	ALBEDO = clamp(base + sp * 0.7, vec3(0.0), vec3(1.0));
	ROUGHNESS = mix(0.95, 0.55, v_track);
	SPECULAR = mix(0.25, 0.05, v_track);
}
"

