code = "shader_type spatial;
// Checker through the cut faces' UVs, which are in mesh units: 4 cells to a unit.
void fragment() {
	vec2 cell = floor(UV * 4.0);
	ALBEDO = mix(vec3(0.12, 0.13, 0.15), vec3(0.85, 0.86, 0.88), mod(cell.x + cell.y, 2.0));
	ROUGHNESS = 0.9;
}
"

